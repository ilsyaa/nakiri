# Application Key
KEY=your-secret-key-here

# WhatsApp Session Configuration
SESSION_ID=main

# Cache Configuration (lru atau redis)
CACHE_DRIVER=lru
REDIS_URL=

# Database Configuration (sqlite atau mysql)
DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_DATABASE=nakiri

# Zapo Store Configuration
STORE_ENABLED=false
STORE_CHATS=true
STORE_CONTACTS=true
STORE_GROUPS=true
STORE_MESSAGES=true
STORE_MESSAGE_RETENTION_DAYS=7
STORE_BATCH_INTERVAL_MS=600000
